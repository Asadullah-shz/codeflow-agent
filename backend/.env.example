# ===========================================================================
# CodeFlow Agent v3 — backend environment template
# Copy to `.env` (never commit it): cp .env.example .env
# ===========================================================================

# --- LLM provider (any OpenAI-compatible endpoint) -------------------------
# Groq example:  OPENAI_API_KEY=gsk_...   OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OpenAI:        OPENAI_API_KEY=sk-...    OPENAI_BASE_URL=https://api.openai.com/v1
# Local Ollama:  OPENAI_API_KEY=ollama    OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# --- Agent behaviour -------------------------------------------------------
# Self-correction budget before the run is marked "exhausted"
MAX_ATTEMPTS=3
TEMPERATURE=0.2

# --- FastAPI server (used by `python main.py`) ----------------------------
HOST=0.0.0.0
PORT=8000
