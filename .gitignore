# ===========================================================================
# CodeFlow Agent v3 — repository ignore rules
# ===========================================================================

# --- Secrets / environment -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Python / backend ------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
dist/
build/

# --- Agent runtime artifacts ----------------------------------------------
# The agent writes refactored code + a nested local Git repo into backend/output/
backend/output/
*.db
*.sqlite
*.sqlite3
*.log

# --- Node / Next.js frontend ----------------------------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.env.local

# --- OS / editors ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# --- Duplicate artifacts from double-downloading --------------------------
# Files such as "agent(1).py" / "README(1).md" are byte-identical copies of
# their originals. Ignore them so only the canonical files are published.
*(1)
*(1).*
